{
  "name": "tehreer-react-native",
  "version": "0.1.0",
  "description": "React Native wrapper of Tehreer Core, a lightweight text engine, built on a C++ JSI layer.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/specs",
    "cpp",
    "ios",
    "android",
    "!android/build",
    "!android/.cxx",
    "!android/.gradle",
    "!android/local.properties",
    "Libraries/TehreerCore/Headers",
    "Libraries/TehreerCore/Source",
    "Libraries/TehreerCore/CMakeLists.txt",
    "Libraries/TehreerCore/Tehreer.cmake.in",
    "Libraries/TehreerCore/tehreer.pc.in",
    "Libraries/TehreerCore/LICENSE",
    "Libraries/TehreerCore/NOTICE",
    "Libraries/Dependencies",
    "tehreer-react-native.podspec",
    "react-native.config.cjs",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "prepack": "node scripts/pack-vendor.mjs prepack",
    "postpack": "node scripts/pack-vendor.mjs postpack",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --test \"tests/*.test.ts\"",
    "generate": "node scripts/generate-bindings.mjs",
    "generate:check": "node scripts/generate-bindings.mjs --check",
    "generate:unicode": "node scripts/generate-unicode-enums.mjs",
    "generate:unicode:check": "node scripts/generate-unicode-enums.mjs --check",
    "setup": "scripts/fetch-deps",
    "test:ios": "node scripts/test-device.mjs ios",
    "test:android": "node scripts/test-device.mjs android",
    "test:packed": "node scripts/test-packed.mjs"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "eslint": "^10.13.0",
    "react": "19.3.1",
    "react-native": "0.88.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "codegenConfig": {
    "name": "TehreerSpec",
    "type": "all",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.tehreer.reactnative"
    },
    "ios": {
      "modules": {
        "NativeTehreer": {
          "className": "TehreerModuleProvider"
        }
      },
      "components": {
        "TLinePaint": {
          "className": "TLinePaint"
        }
      }
    }
  }
}
