{
  "name": "tehreer-react-native",
  "version": "0.1.0",
  "description": "React Native wrapper of Tehreer Core, a lightweight text engine, built on a C++ JSI layer.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/specs",
    "cpp",
    "ios",
    "android",
    "Libraries/TehreerCore",
    "tehreer-react-native.podspec",
    "react-native.config.cjs",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --test \"tests/*.test.ts\"",
    "generate": "node scripts/generate-bindings.mjs",
    "generate:check": "node scripts/generate-bindings.mjs --check",
    "generate:unicode": "node scripts/generate-unicode-enums.mjs",
    "generate:unicode:check": "node scripts/generate-unicode-enums.mjs --check",
    "setup": "scripts/fetch-deps",
    "test:ios": "node scripts/test-device.mjs ios",
    "test:android": "node scripts/test-device.mjs android"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "eslint": "^10.13.0",
    "react": "19.3.1",
    "react-native": "0.88.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "codegenConfig": {
    "name": "TehreerSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.tehreer.reactnative"
    },
    "ios": {
      "modules": {
        "NativeTehreer": {
          "className": "TehreerModuleProvider"
        }
      }
    }
  }
}
